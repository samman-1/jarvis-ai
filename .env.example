# Jarvis AI — frontend environment variables.
# Copy this file to .env.local and fill in the values.
#
# IMPORTANT: every VITE_* variable is bundled into the public client JS.
# Treat them all as PUBLIC. Never put a real secret (API key, Turnstile SECRET, etc.) here.

# n8n webhook the Book-a-Meeting form posts to (use the Production URL).
VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/book-meeting

# Cloudflare Turnstile SITE key (public, safe to expose).
# Leave EMPTY to disable the CAPTCHA entirely — the form still works without it.
# The matching Turnstile SECRET key is configured in n8n, never here.
VITE_TURNSTILE_SITE_KEY=
