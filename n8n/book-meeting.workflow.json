    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=Thank you for contacting JARVIS AI",
        "bodyContent": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<title>JARVIS AI</title>\n<style>\n  body { margin:0; padding:0; }\n  a { text-decoration:none; }\n  @media only screen and (max-width:620px) {\n    .container { width:100% !important; }\n    .px { padding-left:22px !important; padding-right:22px !important; }\n    .h1 { font-size:27px !important; line-height:33px !important; }\n  }\n</style>\n</head>\n<body style=\"margin:0; padding:0; background:#050505;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#050505;\">\n  <tr><td align=\"center\" style=\"padding:32px 16px;\">\n\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" class=\"container\" style=\"width:600px; max-width:600px; background:#0a0a0a; border:1px solid #1f1f1f;\">\n      <tr><td style=\"height:4px; background:#FF4500; font-size:0; line-height:0;\">&nbsp;</td></tr>\n\n      <tr><td style=\"padding:34px 40px 0 40px;\" class=\"px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td align=\"left\" style=\"font-family:Arial,Helvetica,sans-serif; font-weight:800; font-size:22px; letter-spacing:6px; color:#ffffff;\">JARVIS</td>\n          <td align=\"right\" style=\"font-family:'Courier New',Courier,monospace; font-size:10px; letter-spacing:2px; color:#FF4500; text-transform:uppercase;\">[ PARTNERSHIP PROTOCOL ]</td>\n        </tr></table>\n      </td></tr>\n\n      <tr><td style=\"padding:26px 40px 0 40px;\" class=\"px\">\n        <span style=\"font-family:'Courier New',Courier,monospace; font-size:11px; letter-spacing:2px; color:#22c55e; text-transform:uppercase;\">&#9679;&nbsp; REQUEST AUTHENTICATED</span>\n      </td></tr>\n\n      <tr><td style=\"padding:12px 40px 0 40px;\" class=\"px\">\n        <h1 class=\"h1\" style=\"margin:0; font-family:Arial,Helvetica,sans-serif; font-weight:800; font-size:34px; line-height:40px; color:#ffffff; text-transform:uppercase; letter-spacing:-0.5px;\">Thank you,<br>{{ $('Webhook').item.json.body.name }}.</h1>\n      </td></tr>\n\n      <tr><td style=\"padding:20px 40px 0 40px; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px; color:#b3b3b3;\" class=\"px\">\n        <p style=\"margin:0 0 16px 0;\">We've received your request, and our engineering team is already reviewing your parameters.</p>\n        <p style=\"margin:0;\">We'll reach out shortly to schedule your strategy meeting. Standby for a priority email from our team.</p>\n      </td></tr>\n\n      <tr><td style=\"padding:28px 40px 0 40px;\" class=\"px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#111111; border:1px solid #1f1f1f;\">\n          <tr><td style=\"padding:18px 22px; font-family:'Courier New',Courier,monospace; font-size:12px; line-height:22px; color:#888888; letter-spacing:1px;\">\n            <span style=\"color:#FF4500; text-transform:uppercase;\">// Request Summary</span><br>\n            <span style=\"color:#777777;\">SECTOR:</span> <span style=\"color:#ffffff;\">{{ $('Webhook').item.json.body.sector }}</span><br>\n            <span style=\"color:#777777;\">SYSTEM:</span> <span style=\"color:#ffffff;\">{{ $('Webhook').item.json.body.system }}</span>\n          </td></tr>\n        </table>\n      </td></tr>\n\n      <tr><td style=\"padding:28px 40px 0 40px;\" class=\"px\"><div style=\"height:1px; background:#1f1f1f; font-size:0; line-height:0;\">&nbsp;</div></td></tr>\n\n      <tr><td style=\"padding:22px 40px 34px 40px; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:21px; color:#888888;\" class=\"px\">\n        <strong style=\"color:#ffffff;\">The JARVIS Team</strong><br>\n        JARVIS AI &mdash; Autonomous Operational Architecture<br>\n        <span style=\"color:#666666;\">Engineered in Saudi. Used globally.</span><br>\n        <a href=\"mailto:partners@jarvisksa.com\" style=\"color:#FF4500;\">partners@jarvisksa.com</a>&nbsp; &middot; &nbsp;<a href=\"https://jarvisksa.com\" style=\"color:#FF4500;\">jarvisksa.com</a>\n      </td></tr>\n    </table>\n\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" class=\"container\" style=\"width:600px; max-width:600px;\">\n      <tr><td align=\"center\" style=\"padding:18px 16px; font-family:'Courier New',Courier,monospace; font-size:10px; letter-spacing:1px; color:#444444; text-transform:uppercase;\">JARVIS AI &middot; Everything is working.</td></tr>\n    </table>\n\n  </td></tr>\n</table>\n</body>\n</html>\n",
        "toRecipients": "={{ $('Webhook').item.json.body.email }}",
        "additionalFields": {
          "bodyContentType": "html"
        }
      },
