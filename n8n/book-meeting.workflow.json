{
  "name": "Jarvis - Book a Meeting",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "book-meeting",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://jarvisksa.com,https://www.jarvisksa.com,http://localhost:3000"
        }
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -360,
        300
      ],
      "webhookId": "book-meeting"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-honeypot",
              "leftValue": "={{ $('Webhook').item.json.body.company_website }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-honeypot",
      "name": "Is Human? (honeypot empty)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -140,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=New Meeting Request — {{ $('Webhook').item.json.body.name }} ({{ $('Webhook').item.json.body.company }})",
        "bodyContent": "=<h2>New Book-a-Meeting Request</h2>\n<table cellpadding=\"6\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px\">\n  <tr><td><b>Name</b></td><td>{{ $('Webhook').item.json.body.name }}</td></tr>\n  <tr><td><b>Email</b></td><td>{{ $('Webhook').item.json.body.email }}</td></tr>\n  <tr><td><b>Company</b></td><td>{{ $('Webhook').item.json.body.company }}</td></tr>\n  <tr><td><b>Phone</b></td><td>{{ $('Webhook').item.json.body.phone }}</td></tr>\n  <tr><td><b>Sector</b></td><td>{{ $('Webhook').item.json.body.sector }}</td></tr>\n  <tr><td><b>System Needed</b></td><td>{{ $('Webhook').item.json.body.system }}</td></tr>\n  <tr><td><b>Site Language</b></td><td>{{ $('Webhook').item.json.body.language }}</td></tr>\n</table>\n<p style=\"color:#888;font-size:12px\">Reply directly to this email to reach the lead.</p>",
        "toRecipients": "partners@jarvisksa.com",
        "additionalFields": {
          "bodyContentType": "html",
          "replyTo": "={{ $('Webhook').item.json.body.email }}"
        }
      },
      "id": "node-notify-team",
      "name": "Email Team (partners@)",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        120,
        200
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-lang-ar",
              "leftValue": "={{ $('Webhook').item.json.body.language }}",
              "rightValue": "ar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-lang",
      "name": "Language == AR?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        340,
        200
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=شكراً لتواصلك مع جارفيس",
        "bodyContent": "=<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<title>JARVIS AI</title>\n<style>\n  body { margin:0; padding:0; }\n  a { text-decoration:none; }\n  @media only screen and (max-width:620px) {\n    .container { width:100% !important; }\n    .px { padding-left:22px !important; padding-right:22px !important; }\n    .h1 { font-size:27px !important; line-height:36px !important; }\n  }\n</style>\n</head>\n<body style=\"margin:0; padding:0; background:#050505;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#050505;\" dir=\"rtl\">\n  <tr><td align=\"center\" style=\"padding:32px 16px;\">\n\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" class=\"container\" style=\"width:600px; max-width:600px; background:#0a0a0a; border:1px solid #1f1f1f;\">\n      <tr><td style=\"height:4px; background:#FF4500; font-size:0; line-height:0;\">&nbsp;</td></tr>\n\n      <tr><td style=\"padding:34px 40px 0 40px;\" class=\"px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td align=\"right\" style=\"font-family:Arial,Helvetica,sans-serif; font-weight:800; font-size:22px; letter-spacing:6px; color:#ffffff;\">JARVIS</td>\n          <td align=\"left\" style=\"font-family:'Courier New',Courier,monospace; font-size:10px; letter-spacing:1px; color:#FF4500;\">[ بروتوكول الشراكة ]</td>\n        </tr></table>\n      </td></tr>\n\n      <tr><td style=\"padding:26px 40px 0 40px;\" class=\"px\">\n        <span style=\"font-family:Tahoma,Arial,sans-serif; font-size:12px; color:#22c55e;\">&#9679;&nbsp; تم توثيق الطلب</span>\n      </td></tr>\n\n      <tr><td style=\"padding:12px 40px 0 40px;\" class=\"px\">\n        <h1 class=\"h1\" style=\"margin:0; font-family:Tahoma,Arial,sans-serif; font-weight:800; font-size:32px; line-height:44px; color:#ffffff;\">شكراً لك،<br>{{ $('Webhook').item.json.body.name }}</h1>\n      </td></tr>\n\n      <tr><td style=\"padding:20px 40px 0 40px; font-family:Tahoma,Arial,sans-serif; font-size:15px; line-height:28px; color:#b3b3b3;\" class=\"px\">\n        <p style=\"margin:0 0 16px 0;\">لقد استلمنا طلبك، وفريقنا الهندسي يراجع تفاصيله الآن.</p>\n        <p style=\"margin:0;\">سنتواصل معك قريباً لتحديد موعد جلستك الاستراتيجية. ترقّب بريداً ذا أولوية من فريقنا.</p>\n      </td></tr>\n\n      <tr><td style=\"padding:28px 40px 0 40px;\" class=\"px\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#111111; border:1px solid #1f1f1f;\">\n          <tr><td style=\"padding:18px 22px; font-family:Tahoma,Arial,sans-serif; font-size:13px; line-height:26px; color:#888888;\">\n            <span style=\"color:#FF4500;\">// ملخص الطلب</span><br>\n            <span style=\"color:#777777;\">القطاع:</span> <span style=\"color:#ffffff;\">{{ $('Webhook').item.json.body.sector }}</span><br>\n            <span style=\"color:#777777;\">النظام:</span> <span style=\"color:#ffffff;\">{{ $('Webhook').item.json.body.system }}</span>\n          </td></tr>\n        </table>\n      </td></tr>\n\n      <tr><td style=\"padding:28px 40px 0 40px;\" class=\"px\"><div style=\"height:1px; background:#1f1f1f; font-size:0; line-height:0;\">&nbsp;</div></td></tr>\n\n      <tr><td style=\"padding:22px 40px 34px 40px; font-family:Tahoma,Arial,sans-serif; font-size:13px; line-height:24px; color:#888888;\" class=\"px\">\n        <strong style=\"color:#ffffff;\">فريق جارفيس</strong><br>\n        جارفيس &mdash; بنية تشغيلية ذاتية<br>\n        <span style=\"color:#666666;\">صُنع في السعودية. يُستخدم عالمياً.</span><br>\n        <a href=\"mailto:partners@jarvisksa.com\" style=\"color:#FF4500;\" dir=\"ltr\">partners@jarvisksa.com</a>&nbsp; &middot; &nbsp;<a href=\"https://jarvisksa.com\" style=\"color:#FF4500;\" dir=\"ltr\">jarvisksa.com</a>\n      </td></tr>\n    </table>\n\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" class=\"container\" style=\"width:600px; max-width:600px;\">\n      <tr><td align=\"center\" style=\"padding:18px 16px; font-family:Tahoma,Arial,sans-serif; font-size:11px; color:#444444;\">جارفيس &middot; كل شيء يعمل.</td></tr>\n    </table>\n\n  </td></tr>\n</table>\n</body>\n</html>\n",
        "toRecipients": "={{ $('Webhook').item.json.body.email }}",
        "additionalFields": {
          "bodyContentType": "html"
        }
      },
      "id": "node-thanks-ar",
